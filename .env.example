# Happy Billing 环境变量配置
# 复制此文件为 .env 并根据需要修改

# ====================
# MySQL 配置
# ====================
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=happy_billing_2024
MYSQL_DATABASE=happy_billing
MYSQL_USER=billing_user
MYSQL_PASSWORD=billing_pass_2024

# ====================
# Redis 配置
# ====================
REDIS_PORT=6379

# ====================
# ClickHouse 配置
# ====================
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=happy_billing
CLICKHOUSE_USER=billing_user
CLICKHOUSE_PASSWORD=billing_pass_2024

# ====================
# Kafka 配置
# ====================
KAFKA_PORT=29092

# ====================
# Jaeger 配置（链路追踪）
# ====================
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268
JAEGER_AGENT_PORT=6831

# ====================
# Grafana 配置（监控可视化）
# ====================
GRAFANA_PORT=3000
# 默认账号: admin/admin

# ====================
# Loki 配置（日志聚合）
# ====================
LOKI_PORT=3100

# ====================
# Promtail 配置（日志采集）
# ====================
PROMTAIL_PORT=9080

# ====================
# 管理工具（可选）
# ====================
ADMINER_PORT=8081
REDIS_INSIGHT_PORT=8001

